{
  "name": "tvattligan",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "node scripts/master-command.mjs migrate-local",
    "local:secret": "node scripts/local-secret.mjs",
    "push:keys": "node scripts/push-keys.mjs",
    "pwa:icons": "node scripts/create-icons.mjs",
    "setup": "npm run local:secret && npm run db:migrate",
    "deploy": "node scripts/master-command.mjs deploy",
    "db:migrate:remote": "node scripts/master-command.mjs migrate-remote",
    "master:prepare": "node scripts/master-command.mjs prepare",
    "master:check": "node scripts/master-command.mjs check"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "mammoth": "^1.13.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.0",
    "@cloudflare/workers-types": "^5.20261007.1",
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jszip": "^3.10.2",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.148.0"
  }
}
