{
    "$schema":  "node_modules/wrangler/config-schema.json",
    "name":  "tvattligan-karlshamn",
    "main":  "worker/index.ts",
    "compatibility_date":  "2026-10-07",
    "assets":  {
                   "directory":  "./dist/client",
                   "binding":  "ASSETS",
                   "not_found_handling":  "single-page-application",
                   "run_worker_first":  [
                                            "/api/*"
                                        ]
               },
    "d1_databases":  [
                         {
                             "binding":  "DB",
                             "database_name":  "station-karlshamn",
                             "database_id":  "39f8652e-6bc9-440c-848a-55a7a9c034a8",
                             "migrations_dir":  "migrations-master"
                         }
                     ],
    "vars":  {
                 "STATION_ID":  "karlshamn"
             },
    "observability":  {
                          "enabled":  true
                      }
}